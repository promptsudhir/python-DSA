## search insertion position 
# return the index of the target if found, if not, return the index it should be there

nums =[1,3,5,6]
target = 5

def solution(nums,target):
        dup_list = nums.copy()
    
        if target in nums:
            return nums.index(target)
        
        dup_list.append(target)
        dup_list.sort()
        return dup_list.index(target)

print(solution(nums,target))    


 

