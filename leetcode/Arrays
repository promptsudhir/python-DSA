# Two sum 
nums = [3,4,5,6,7]
target = 13

def twoSum(nums , target):
    for i in range(len(nums)):
         for j in  range( i + 1, len(nums)):
             if nums[i] + nums[j] == target:
                    return [ i , j ]
              
#number of moves required to make all the elements equal

def minMoves(nums) :
    largest = max(nums)
    moves = 0
    for num in nums:
        moves = moves + largest - num


    return moves    
        
