# majority element 
nums = [2,1,2,1,2,2,1,2,1]
def solution(nums):
    count = {}
    for num in nums:
        if num in count:
             count[num] +=1
        else: count[num] = 1
 # by doing this we are creating a dict where we add the elements of num as key and we are using their frequencies as values

# now we will iterate through the count dict which now has key n values to find the key with the most occurence
    for counts in count:
         if count[counts] > len(num)//2:
          return count

